<UserControl x:Class="IntuneLogMonitor.App.Views.AppWorkloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IntuneLogMonitor.App.ViewModels"
             xmlns:views="clr-namespace:IntuneLogMonitor.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppWorkloadViewModel}"
             d:DesignHeight="800" d:DesignWidth="1300">
    <UserControl.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Delivery Optimization & cache sizes, below: header of the download list -->
        <StackPanel Grid.Row="0">
            <Expander IsExpanded="True" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock FontWeight="SemiBold" FontSize="14" Text="Delivery Optimization &amp; Caches" />
                </Expander.Header>
                <views:DeliveryOptimizationPanel Margin="0,4,0,0" DataContext="{Binding DeliveryOptimization}" />
            </Expander>
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" Text="Downloads (AppWorkload.log)" FontSize="14" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="Gray"
                           Text="{Binding FilePath, StringFormat='File: {0}'}" TextTrimming="CharacterEllipsis" />
                <Border />
            </DockPanel>
        </StackPanel>

        <!-- Download list -->
        <DataGrid Grid.Row="1" x:Name="DownloadGrid"
                  ItemsSource="{Binding Downloads}"
                  SelectedItem="{Binding SelectedDownload, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEE" RowHeight="26"
                  CanUserReorderColumns="True" CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding NotesText}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasNotes}" Value="False">
                            <Setter Property="ToolTip" Value="{x:Null}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40" ElementStyle="{StaticResource CellTextRight}" />
                <DataGridTextColumn Header="Start time" Binding="{Binding StartTimeText}" Width="135" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="App ID" Binding="{Binding AppId}" Width="250" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="App name" Binding="{Binding AppName}" Width="170" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Total size" Binding="{Binding TotalText}" Width="95" ElementStyle="{StaticResource CellTextRight}" SortMemberPath="Snapshot.TotalBytes" />
                <DataGridTextColumn Header="Current" Binding="{Binding CurrentText}" Width="95" ElementStyle="{StaticResource CellTextRight}" SortMemberPath="Snapshot.CurrentBytes" />
                <DataGridTemplateColumn Header="Progress" Width="150" SortMemberPath="Percent">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" x:Name="Bar" />
                                <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                    <Setter TargetName="Bar" Property="Foreground" Value="#107C10" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="NoActivity">
                                    <Setter TargetName="Bar" Property="Foreground" Value="#CA5010" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Restarted">
                                    <Setter TargetName="Bar" Property="Foreground" Value="#8A8886" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasTotal}" Value="False">
                                    <Setter TargetName="Bar" Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Rate" Binding="{Binding RateText}" Width="95" ElementStyle="{StaticResource CellTextRight}" SortMemberPath="Snapshot.BytesPerSecond" />
                <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingText}" Width="70" ElementStyle="{StaticResource CellTextRight}" SortMemberPath="Snapshot.Remaining" />
                <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="70" ElementStyle="{StaticResource CellTextRight}" SortMemberPath="Snapshot.Duration" />
                <DataGridTemplateColumn Header="Status" Width="*" MinWidth="170" SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontWeight="SemiBold" />
                                <TextBlock Text=" ⓘ" Foreground="#605E5C" x:Name="NoteIcon" Visibility="Collapsed" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#0063B1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Started">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#0063B1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#107C10" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Incomplete">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#A4262C" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="NoActivity">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#CA5010" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Restarted">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#605E5C" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasNotes}" Value="True">
                                    <Setter TargetName="NoteIcon" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4" Background="#E1DFDD" />

        <!-- Filter bar of the log view -->
        <DockPanel Grid.Row="3" Margin="0,4,0,4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Text="Log" Margin="0,0,12,0" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{Binding FilterText}" />
            <Button DockPanel.Dock="Left" Margin="10,0,0,0" Padding="8,1" Content="Clear filter"
                    Command="{Binding ClearFilterCommand}" />
            <CheckBox DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center"
                      IsEnabled="{Binding IsFiltered}" IsChecked="{Binding ShowContextRange}"
                      Content="All lines between start and completion (including other lines)" />
            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding AutoScroll}" Content="Auto-scroll" />
        </DockPanel>

        <!-- Virtualized log table -->
        <DataGrid Grid.Row="4" x:Name="LogGrid"
                  ItemsSource="{Binding VisibleEntries}"
                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  CanUserSortColumns="False" CanUserAddRows="False"
                  RowHeight="20" FontFamily="Consolas" FontSize="12"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Item"
                  ScrollViewer.IsDeferredScrollingEnabled="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                            <Setter Property="Background" Value="{StaticResource WarningBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource WarningForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                            <Setter Property="Background" Value="{StaticResource ErrorBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource ErrorForeground}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSynthetic}" Value="True">
                            <Setter Property="Background" Value="{StaticResource MarkerBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource MarkerForeground}" />
                            <Setter Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}" Width="150" />
                <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="140" />
                <DataGridTextColumn Header="Type" Binding="{Binding Severity}" Width="70" />
                <DataGridTextColumn Header="DL" Binding="{Binding DownloadId}" Width="35" />
                <DataGridTextColumn Header="Message" Binding="{Binding MessageFirstLine}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Details of the selected line (full, possibly multi-line message) -->
        <TextBox Grid.Row="5" Margin="0,6,0,0" Height="80" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                 Text="{Binding SelectedEntryDetails, Mode=OneWay}" />

        <!-- Status bar -->
        <DockPanel Grid.Row="6" Margin="0,6,0,0">
            <TextBlock DockPanel.Dock="Right" Foreground="Gray" Text="{Binding CountersText}" />
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</UserControl>
