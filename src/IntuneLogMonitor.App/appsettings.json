{
  "AppWorkloadMonitor": {
    "LogFilePath": "C:\\ProgramData\\Microsoft\\IntuneManagementExtension\\Logs\\AppWorkload.log",
    "PollIntervalMilliseconds": 1000,
    "ReadExistingContent": true,
    "MaxLogEntries": 250000,
    "InactivityCheckIntervalSeconds": 15,
    "Tracking": {
      "StartMarkerPattern": "via DO, bytes 0/0 for user",
      "ProgressPattern": "bytes\\s+(?<current>\\d+)/(?<total>\\d+)",
      "AppIdPattern": "(?<appId>[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})",
      "AppNamePattern": "(?i)\\bname\\s*[=:]?\\s*(?<appName>.+?)\\)\\s*via\\b",
      "TotalSizeSearchWindow": 5,
      "InactivityTimeoutMinutes": 10,
      "StrictTotalSizeDetection": true,
      "CheckInactivityByLogTime": true,
      "CheckInactivityBySystemClock": true,
      "ResumeAfterNoActivity": true,
      "MarkStalledStartsIncomplete": true
    },
    "DeliveryOptimization": {
      "Enabled": true,
      "RefreshIntervalSeconds": 30,
      "CacheRefreshIntervalSeconds": 5,
      "CommandTimeoutSeconds": 60,
      "PowerShellPath": "powershell.exe",
      "CacheFolders": [
        { "Name": "Delivery-Optimization-Cache", "Path": "%windir%\\ServiceProfiles\\NetworkService\\AppData\\Local\\Microsoft\\Windows\\DeliveryOptimization\\Cache" },
        { "Name": "IME Download (Incoming)", "Path": "%ProgramFiles(x86)%\\Microsoft Intune Management Extension\\Content\\Incoming" },
        { "Name": "IME Staging", "Path": "%ProgramFiles(x86)%\\Microsoft Intune Management Extension\\Content\\Staging" },
        { "Name": "IME Paketcache (IMECache)", "Path": "%windir%\\IMECache" }
      ]
    }
  }
}
